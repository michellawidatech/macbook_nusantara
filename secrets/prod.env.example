# Environment: prod
#
# Copy to secrets/prod.env (gitignored by the *.env rule) and source it:
#
#     set -a && . secrets/prod.env && set +a
#
# This file is for your SHELL. It is deliberately NOT one of the files the
# apps parse: loadApiSecrets and loadEnvFile copy only an allow-list of keys
# out of secrets/webhook-credentials.env, and DATABASE_URL is absent from both
# of those lists on purpose — that shared file still carries a DATABASE_URL
# aimed at nusantara_pos_app, the previous build's live database.
#
# APP_ENV and DATABASE_URL must agree. resolveDatabaseUrl refuses the pair if
# they name different environments, and refuses nusantara_pos_app in every
# environment, so a wrong value fails at startup instead of at a customer.
#
# NOT nusantara_pos_app. That is the previous build, it is still live, and the
# old system is still writing to it (CLAUDE.md, 08 §8).
#
# Before this database is reachable off-localhost, give the role a password
# (packages/db/prisma/roles.sql says the same) and put it here, never in git.
APP_ENV=prod
DATABASE_URL=postgresql://nusantara@localhost:5432/nusantara_pos_prod
