# Nusantara POS — webhook & chatbot credentials (TEMPLATE)
#
# This .example file is committed and MUST stay empty of real values.
# Copy it to `secrets/webhook-credentials.env` and fill that copy in — the real
# file is gitignored by the `*.env` rule in .gitignore:9.
#
#   cp secrets/webhook-credentials.env.example secrets/webhook-credentials.env
#   chmod 600 secrets/webhook-credentials.env
#   git check-ignore -v secrets/webhook-credentials.env   # must print a match
#
# Purpose: one canonical record of every key the chatbot needs, so rebuilding the
# UI cannot lose them. Also keep a copy in a password manager — a gitignored file
# on one laptop is not a backup.
#
# Full documentation: docs/rebuild/07-credentials.md
# Setup walkthrough:  docs/rebuild/06-webhook-integration.md

# ---------- Meta app — shared by WhatsApp and Instagram ----------
# One Meta app signs events for both channels, so APP_SECRET appears once.

# Meta App Secret. HMAC key for the X-Hub-Signature-256 header on every inbound
# event. CRITICAL — a leak lets anyone forge events into the agent.
# App Dashboard > Settings > Basic > App Secret > Show
APP_SECRET=

# A random string YOU invent — not issued by Meta. Echoed back during the
# one-time GET /webhook handshake to prove you own the callback URL.
# Generate with: openssl rand -hex 32
VERIFY_TOKEN=

# Graph API version the clients pin to. Default v25.0.
GRAPH_API_VERSION=v25.0

# ---------- WhatsApp Cloud API ----------

# Permanent System User access token.
# Scopes: whatsapp_business_messaging, whatsapp_business_management
# business.facebook.com > Business Settings > System Users > Generate new token
# Set expiry to NEVER. The 24-hour token from API Setup will strand you.
WHATSAPP_TOKEN=

# The WhatsApp business phone number ID — a numeric id, NOT the phone number.
# App Dashboard > WhatsApp > API Setup
PHONE_NUMBER_ID=

# ---------- Instagram Graph API ----------
# Not set in this repo before the rebuild — obtain per docs/rebuild/06 §5.

# Long-lived / system-user token.
# Scopes: instagram_basic, instagram_manage_comments, instagram_manage_messages,
#         pages_show_list, pages_read_engagement
IG_ACCESS_TOKEN=

# Connected IG Business account id, used in Graph paths.
# curl "https://graph.facebook.com/v25.0/me/accounts?fields=instagram_business_account&access_token=$IG_ACCESS_TOKEN"
IG_BUSINESS_ACCOUNT_ID=

# ---------- Agent (LLM) ----------

# Anthropic API key used by the agent pipeline. Billable — revoke in the console
# if exposed. Only one of these two is needed.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# ---------- Application ----------

# Postgres connection string for the POS database (contains a password).
DATABASE_URL=

# Signs the POS session cookie. Rotating it logs every staff member out.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Break-glass access to the Monitor app on :4100.
MONITOR_TOKEN=

# Webhook listener port.
PORT=3001

# ---------- Deliberately NOT carried over ----------
# The marketplace and competitor-analysis features are out of scope. Revoke these
# at the source, do not just delete the lines:
#   SHOPEE_PARTNER_ID, SHOPEE_PARTNER_KEY, SHOPEE_SHOP_ID, SHOPEE_REFRESH_TOKEN,
#   SHOPEE_OPEN_BASE_URL, MARKET_SCRAPE*
# AUTH_SECRET (legacy Next.js build) — delete once nothing reads it.
