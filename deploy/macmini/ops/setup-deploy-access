#!/bin/zsh
# One-time setup of the deploy pipeline's door into the Mac mini
# (docs/deploy-pipeline.md). Run it as an admin, from a directory holding this
# script and nusantara-deploy side by side:
#
#   sudo zsh setup-deploy-access 'ssh-ed25519 AAAA… github-actions@nusantara'
#
# It creates the hidden account the CI logs in as, installs nusantara-deploy
# root-owned where no release can overwrite it, gives the account exactly one
# sudo right — to run that script — and pins the CI's key to it with a forced
# command, so the key cannot open a shell, cannot forward anything except one
# tunnel to PostgreSQL, and cannot run anything but the script's four verbs.
#
# Re-running it is how a new nusantara-deploy or a rotated key reaches the
# machine. It changes nothing else.
setopt err_exit no_unset pipe_fail
umask 022
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

user=nusantara-deploy
home=/var/nusantara-deploy
installer=/usr/local/libexec/nusantara-deploy
sudoers=/etc/sudoers.d/nusantara-deploy
here=${0:A:h}

die() { print -u2 -- "setup-deploy-access: $*"; exit 1 }

(( EUID == 0 )) || die "run it with sudo"
(( $# == 1 )) || die "usage: sudo zsh setup-deploy-access 'ssh-ed25519 AAAA… comment'"
key=$1
[[ $key =~ '^ssh-ed25519 [A-Za-z0-9+/]+={0,2}( [A-Za-z0-9@._+-]+)?$' ]] ||
  die "that is not one ssh-ed25519 public key line"
[[ -f $here/nusantara-deploy ]] || die "nusantara-deploy must sit next to this script"
[[ -d /opt/nusantara/releases ]] || die "/opt/nusantara is not set up yet — docs/deploy-macmini.md §2 first"
zsh -n $here/nusantara-deploy || die "$here/nusantara-deploy does not parse"

# 1. The account: hidden (a UID under 500 keeps it off the login window), no
#    password at all, key-only over SSH.
if ! id $user >/dev/null 2>&1; then
  used=(${(f)"$(dscl . -list /Users UniqueID | awk '{ print $2 }')"})
  uid=
  for (( i = 398; i >= 300; i-- )); do
    if (( ! ${used[(Ie)$i]} )); then uid=$i; break; fi
  done
  [[ -n $uid ]] || die "no free UID between 300 and 398"
  dscl . -create /Users/$user
  dscl . -create /Users/$user UniqueID $uid
  dscl . -create /Users/$user PrimaryGroupID 20
  dscl . -create /Users/$user UserShell /bin/zsh
  dscl . -create /Users/$user NFSHomeDirectory $home
  dscl . -create /Users/$user RealName "Nusantara deploy (CI)"
  dscl . -create /Users/$user Password '*'
  dscl . -create /Users/$user IsHidden 1
  print "created $user (UID $uid)"
fi
install -d -m 700 -o $user -g staff $home $home/.ssh

# Remote Login limited to named users means membership of this group.
if dscl . -read /Groups/com.apple.access_ssh >/dev/null 2>&1; then
  dseditgroup -o edit -a $user -t user com.apple.access_ssh
  print "added $user to Remote Login's allowed users"
fi

# 2. The installer, where only root can write.
install -d -m 755 -o root -g wheel ${installer:h}
install -m 755 -o root -g wheel $here/nusantara-deploy $installer
print "installed $installer"

# 3. The one privilege. No arguments are named, so any are allowed; the script
#    itself refuses everything but its four verbs.
tmp=$(mktemp)
print -r -- "# The CI deploy key's one privilege (deploy/macmini/ops/setup-deploy-access).
$user ALL=(root) NOPASSWD: $installer" >$tmp
visudo -cf $tmp >/dev/null || { rm -f $tmp; die "the sudoers rule did not validate" }
install -m 440 -o root -g wheel $tmp $sudoers
rm -f $tmp
grep -q '^#includedir /private/etc/sudoers.d' /etc/sudoers ||
  print -u2 "⚠️  /etc/sudoers has no '#includedir /private/etc/sudoers.d' — the rule above is never read"
print "installed $sudoers"

# 4. The key, pinned to the installer. `restrict` turns off the pty, agent and
#    every forwarding; `port-forwarding` + `permitopen` turn back on exactly the
#    one tunnel the migrations use. $SSH_ORIGINAL_COMMAND is expanded by the
#    account's shell and reaches the script as ONE argument.
{
  print -r -- '# GitHub Actions deploy key: runs nusantara-deploy and opens one tunnel to PostgreSQL. Nothing else.'
  print -r -- 'restrict,port-forwarding,permitopen="127.0.0.1:5432",command="/usr/bin/sudo -n /usr/local/libexec/nusantara-deploy \"$SSH_ORIGINAL_COMMAND\""' "$key"
} >$home/.ssh/authorized_keys
chown ${user}:staff $home/.ssh/authorized_keys
chmod 600 $home/.ssh/authorized_keys
print "pinned the key in $home/.ssh/authorized_keys"

# 5. Proof, and what GitHub needs.
sudo -l -U $user | grep -qF "NOPASSWD: $installer" || die "sudo does not show the rule for $user"
launchctl print system/com.openssh.sshd >/dev/null 2>&1 ||
  print -u2 "⚠️  Remote Login looks off: System Settings → General → Sharing → Remote Login"

print "
Done. For GitHub → Settings → Environments → prod:
  variable DEPLOY_USER         $user
  variable DEPLOY_KNOWN_HOSTS  <DEPLOY_HOST> $(cut -d' ' -f1,2 /etc/ssh/ssh_host_ed25519_key.pub)
(<DEPLOY_HOST> is this machine's MagicDNS name, e.g. nusantara-mini.tailXXXX.ts.net)"
