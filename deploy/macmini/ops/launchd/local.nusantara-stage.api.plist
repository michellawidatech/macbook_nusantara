<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  STAGING's API on :4001 (docs/staging.md). The same release format as the
  shop's, installed under /opt/nusantara-stage; ops/run finds that install's
  etc/ from where it sits. The first staging deploy loads it — nobody needs
  to install it by hand (ops/nusantara-deploy in its staging mode).
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.nusantara-stage.api</string>
	<key>UserName</key>
	<string>_nusantara</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/nusantara-stage/current/ops/run</string>
		<string>api</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/opt/nusantara-stage/var</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>/opt/nusantara-stage</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/opt/nusantara-stage/logs/api.log</string>
	<key>StandardErrorPath</key>
	<string>/opt/nusantara-stage/logs/api.log</string>
</dict>
</plist>
