<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Meta webhook receiver on :3001. Only install it when WhatsApp is being
  moved to this machine — pointing Meta here is a change to the live channel.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.nusantara.webhook</string>
	<key>UserName</key>
	<string>_nusantara</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/nusantara/current/ops/run</string>
		<string>webhook</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/opt/nusantara/var</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>/opt/nusantara</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/opt/nusantara/logs/webhook.log</string>
	<key>StandardErrorPath</key>
	<string>/opt/nusantara/logs/webhook.log</string>
</dict>
</plist>
