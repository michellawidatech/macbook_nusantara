<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  pg_dump every night at 22:30, after the shop closes. If the Mac mini is
  asleep or off at 22:30, launchd runs it at the next wake.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.nusantara.backup</string>
	<key>UserName</key>
	<string>_nusantara</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/nusantara/current/ops/backup</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/opt/nusantara/var</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>22</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/opt/nusantara/logs/backup.log</string>
	<key>StandardErrorPath</key>
	<string>/opt/nusantara/logs/backup.log</string>
</dict>
</plist>
