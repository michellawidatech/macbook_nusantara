# /opt/nusantara/etc/api.env — the API only. Owner _nusantara, mode 600.
API_PORT='4000'

# The address staff type into the browser. Both must be that same https origin:
# express-openid-connect builds the Auth0 redirect_uri from AUTH0_BASE_URL.
CORS_ORIGIN='https://pos.example.com'
AUTH0_BASE_URL='https://pos.example.com'

AUTH0_DOMAIN='CHANGE_ME.us.auth0.com'
AUTH0_CLIENT_ID='CHANGE_ME'
AUTH0_CLIENT_SECRET='CHANGE_ME'
# Encrypts the Auth0 session cookie: openssl rand -hex 32
AUTH0_SECRET='CHANGE_ME'

# Optional. Without it the chat agent stays switched off, and says so at boot.
# ANTHROPIC_API_KEY='CHANGE_ME'
