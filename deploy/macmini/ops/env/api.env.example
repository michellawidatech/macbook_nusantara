# /opt/nusantara/etc/api.env — the API only. Owner _nusantara, mode 600.
API_PORT='4000'

# The address staff type into the browser: the https origin tailscale serve
# gives the Mac mini. CORS is locked to it.
CORS_ORIGIN='https://pos.example.com'

# Sign-in is the app's own (2026-09-18). An api.env from before then still
# carries five AUTH0_* lines; nothing reads them any more, and they can go.

# tailscale serve and Caddy both run on this machine, so every hop in front of
# the API is loopback — the default. Only change it for a different layout.
# TRUST_PROXY='loopback'

# Optional. Without it the chat agent stays switched off, and says so at boot.
# ANTHROPIC_API_KEY='CHANGE_ME'
# The chat model Draft and the simulator use; unset is claude-haiku-5-5. Keep
# it the same as worker.env's, or the simulator tries a bot nobody runs.
# CHATBOT_MODEL='claude-haiku-5-5'

# The chatbot worker's door into the POS (chatbot v2, /api/agent/v1). The SAME
# value goes in worker.env; nothing else should hold it. Unset, the route
# answers 503 to everything and the worker runs its tools locally instead.
# openssl rand -hex 32
# AGENT_API_SECRET='CHANGE_ME'

# WhatsApp through a linked device (2026-10-22, docs/whatsapp-baileys.md):
# the owner's Chatbot → Settings → WhatsApp connection card reaches the
# gateway through these. The SAME secret is in worker.env and wa-gateway.env.
# Unset, the card says this server uses the Cloud API.
# WA_GATEWAY_URL='http://127.0.0.1:3002'
# WA_GATEWAY_SECRET='CHANGE_ME'
