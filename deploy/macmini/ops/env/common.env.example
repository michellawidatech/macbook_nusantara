# /opt/nusantara/etc/common.env — read by EVERY Nusantara process.
# Owner _nusantara, mode 600. Single-quote every value (a bare & in a URL
# would end the line early).

# APP_ENV and the database NAME must agree, or the process refuses to start
# (packages/db/src/environment.ts). prod means nusantara_pos_prod.
APP_ENV='prod'

# nusantara_app, never the owner: it may append to UnitEvent and may never
# update or delete it. Use a hex password (openssl rand -hex 24) so nothing in
# it needs URL-escaping.
DATABASE_URL='postgresql://nusantara_app:CHANGE_ME@127.0.0.1:5432/nusantara_pos_prod?connection_limit=5'

# Homebrew's node@24 is keg-only, and launchd's PATH does not include it.
NODE_BIN='/opt/homebrew/opt/node@24/bin/node'
