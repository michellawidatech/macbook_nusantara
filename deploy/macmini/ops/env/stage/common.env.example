# /opt/nusantara-stage/etc/common.env — read by every STAGING process
# (docs/staging.md). Owner _nusantara, mode 600. Single-quote every value.
#
# docs/staging.md §2 writes this file FROM the shop's own common.env with sed,
# so the password is never typed: only APP_ENV and the database name differ.

# stage means nusantara_pos_stage, and the process refuses any other database
# (packages/db/src/environment.ts) — staging cannot open the shop's by a typo.
APP_ENV='stage'

# The SAME nusantara_app login as the shop's: PostgreSQL roles belong to the
# cluster, not to a database. Only the database name is staging's.
DATABASE_URL='postgresql://nusantara_app:CHANGE_ME@127.0.0.1:5432/nusantara_pos_stage?connection_limit=5'

NODE_BIN='/opt/homebrew/opt/node@24/bin/node'
