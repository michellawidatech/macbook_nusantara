# /opt/nusantara-stage/etc/api.env — staging's API only. Owner _nusantara, mode 600.
# The shop's API is on 4000; local.nusantara-stage.caddy proxies to this one.
API_PORT='4001'

# The address you type into the browser. CORS is locked to it.
CORS_ORIGIN='https://staging-pos.macbooknusantara.com'

# No ANTHROPIC_API_KEY: staging's "ask the bot to draft" stays off, so a test
# on a copy of the shop's inbox spends nothing. Add one to try the chat agent.
