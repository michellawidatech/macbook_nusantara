# /opt/nusantara/etc/webhook.env — the Meta webhook only. Owner _nusantara, mode 600.
# Needed only when WhatsApp is served from this machine.
WEBHOOK_PORT='3001'

# Empty APP_SECRET means every inbound event is rejected — fail-closed.
APP_SECRET='CHANGE_ME'
VERIFY_TOKEN='CHANGE_ME'
WHATSAPP_TOKEN='CHANGE_ME'
PHONE_NUMBER_ID='1200651716467039'
# IG_ACCESS_TOKEN='CHANGE_ME'
# IG_BUSINESS_ACCOUNT_ID='CHANGE_ME'

# Meta has to be able to REACH this. The webhook is on loopback and Caddy only
# serves the POS over the tailnet, so publishing it is a separate, deliberate
# step:  sudo /opt/nusantara/current/ops/whatsapp-funnel up
# It maps only /webhook, publicly, on :8443. docs/chatbot-runbook.md.
