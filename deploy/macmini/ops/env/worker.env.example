# /opt/nusantara/etc/worker.env — the chatbot worker only. Owner _nusantara, mode 600.
# Each has a default: without them the worker starts and says in its first log
# line that it cannot draft or cannot send.
WHATSAPP_TOKEN='CHANGE_ME'
PHONE_NUMBER_ID='1200651716467039'
ANTHROPIC_API_KEY='CHANGE_ME'

# The worker connects as nusantara_agent, NOT common.env's nusantara_app.
# This file is loaded after common.env, so the line below wins. Every pass in
# apps/worker writes only what the agent role is granted (the thread summary,
# the reset, the bot's half of a lead), and as nusantara_app those writes are
# refused — the summary pass swallows the refusal and the note never updates.
# The password is the AGENT one printed in docs/go-live.md step 2.4.
# connection_limit 10: the draft pass answers up to 8 threads at once
# (WORKER_DRAFT_CONCURRENCY), each holding at most one connection.
DATABASE_URL='postgresql://nusantara_agent:CHANGE_ME@127.0.0.1:5432/nusantara_pos_prod?connection_limit=10'

# What the chatbot may do for itself (2026-09-21). See docs/chatbot-runbook.md.
#
#   unset / anything else  the bot answers from the owner's approved sheet and
#                          hands every question about a particular unit to a
#                          person. The safe default while this database holds
#                          master data and not the shop's real stock.
#   'live'                 the bot reads stock and prices, sends the shop's own
#                          photos of a unit, and may book a hold. Negotiation,
#                          payments and complaints still go to a person.
#
# Set it the day the migration lands and the shelf in this database is real.
# AGENT_CAPABILITIES='live'
