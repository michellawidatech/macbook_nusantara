# /opt/nusantara/etc/worker.env — the chatbot worker only. Owner _nusantara, mode 600.
# Each has a default: without them the worker starts and says in its first log
# line that it cannot draft or cannot send.
WHATSAPP_TOKEN='CHANGE_ME'
PHONE_NUMBER_ID='1200651716467039'
ANTHROPIC_API_KEY='CHANGE_ME'

# The chat model (2026-10-22). Unset is claude-haiku-5-5 for both the replies
# and the thread summary; set either to move the bot without a release, then
# restart the worker. (api.env takes CHATBOT_MODEL too, for Draft and the
# simulator.)
# CHATBOT_MODEL='claude-haiku-5-5'
# CHATBOT_SUMMARY_MODEL='claude-haiku-5-5'

# The bot never goes silent (2026-10-27). One model call's limit and its
# retries; a whole turn's deadline (kept under the 120 s thread lease); how
# long an answerable message may wait before the watchdog sends the holding
# line; how long an outbox row may stay claimed before it is requeued. The
# defaults are the values below — set one only to change it.
# CHATBOT_CALL_TIMEOUT_MS=25000
# CHATBOT_CALL_RETRIES=2
# WORKER_TURN_DEADLINE_MS=90000
# WORKER_STALE_MS=180000
# WORKER_OUTBOX_STUCK_MS=300000

# Chat recall (2026-10-22): Voyage AI embeddings through MongoDB Atlas
# (ai.mongodb.com). THIS FILE ONLY — never api.env, never a log, never a doc.
# Unset, older turns are still recalled, by keywords.
# VOYAGE_API_KEY='CHANGE_ME'
# VOYAGE_MODEL='voyage-4-lite'

# The worker connects as nusantara_agent, NOT common.env's nusantara_app.
# This file is loaded after common.env, so the line below wins. Every pass in
# apps/worker writes only what the agent role is granted (the thread summary,
# the reset, the bot's half of a lead), and as nusantara_app those writes are
# refused — the summary pass swallows the refusal and the note never updates.
# The password is the AGENT one printed in docs/go-live.md step 2.4.
# connection_limit 10: the draft pass answers up to 8 threads at once
# (WORKER_DRAFT_CONCURRENCY), each holding at most one connection.
DATABASE_URL='postgresql://nusantara_agent:CHANGE_ME@127.0.0.1:5432/nusantara_pos_prod?connection_limit=10'

# What the chatbot may do for itself when a switch on /chat (Chatbot ->
# Settings) was never pressed. A switch the owner pressed always wins.
# See docs/chatbot-runbook.md.
#
#   unset / anything else  (since 2026-10-27) the POS is the source of truth:
#                          the bot reads stock and prices and sends the shop's
#                          own photos of a unit. Bookings stay off until the
#                          owner switches them on.
#   'live'                 the same, and the bot may book a hold as well.
#   'parallel'             the 2026-09-18 design: answers from the owner's
#                          approved sheet only and hands every question about
#                          a particular unit to a person. For a database whose
#                          shelf is NOT the shop's real one.
#
# Negotiation, payments and complaints go to a person in every mode.
# AGENT_CAPABILITIES='live'

# Chatbot v2: the POS tools (stock, photos, the customer's own bookings and
# profile) go through the API rather than straight to the database, under a
# token that names this turn's customer and nobody else. Both lines, or
# neither — with either missing the worker runs the tools itself, as before.
# The secret is the one in api.env. Loopback: the API is on this machine.
# AGENT_API_URL='http://127.0.0.1:4000/api/agent/v1'
# AGENT_API_SECRET='CHANGE_ME'

# How replies reach WhatsApp (2026-10-22, docs/whatsapp-baileys.md).
#   unset / 'cloud'  Meta's Cloud API with WHATSAPP_TOKEN above — unchanged.
#   'baileys'        the same requests to the shop's own gateway on loopback,
#                    which sends as a device linked to the shop's number. No
#                    WHATSAPP_TOKEN is read or sent in this mode. The secret is
#                    the one in api.env and wa-gateway.env.
# WHATSAPP_TRANSPORT='baileys'
# WA_GATEWAY_URL='http://127.0.0.1:3002'
# WA_GATEWAY_SECRET='CHANGE_ME'
