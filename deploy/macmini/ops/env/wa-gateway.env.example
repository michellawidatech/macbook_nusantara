# /opt/nusantara/etc/wa-gateway.env — the WhatsApp gateway only (Baileys, a
# device linked to the shop's number). Owner _nusantara, mode 600.
# docs/whatsapp-baileys.md. Needed only with WHATSAPP_TRANSPORT=baileys.

# Loopback only; the address is not configurable, the port is.
WA_GATEWAY_PORT='3002'

# What the API and the worker send in x-wa-gateway-secret. The SAME value goes
# in api.env and worker.env. openssl rand -hex 32
WA_GATEWAY_SECRET='CHANGE_ME'

# The linked session. OUTSIDE the release, so a deploy does not unlink the
# number: create it once, owned by _nusantara, mode 700.
WA_GATEWAY_STATE_DIR='/opt/nusantara/var/wa-gateway'

# The webhook it hands every customer message to, signed the way Meta signs.
# APP_SECRET must be the webhook's own (webhook.env), or every delivery is
# refused with 401 and logged as wa-gateway.inbound.refused.
WA_GATEWAY_WEBHOOK_URL='http://127.0.0.1:3001/webhook'
APP_SECRET='CHANGE_ME'
