// ============================================================================
// WhatsApp
// ============================================================================

/// Persisted verbatim before Meta is acked, so a crash mid-pipeline loses
/// nothing (08 §5).
model WaRawEvent {
  id          String    @id @default(cuid())
  /// verbatim Meta payload — shape not ours
  payload     Json
  signatureOk Boolean
  receivedAt  DateTime
  processedAt DateTime?
}

model WaMessage {
  id              String      @id @default(cuid())
  waMessageId     String      @unique
  /// wa_id
  from            String
  customerId      String?
  name            String?
  text            String?
  msgType         String
  ts              DateTime
  direction       WaDirection
  status          WaMsgStatus
  intent          String?
  /// LLM extraction — shape not ours
  entities        Json
  replyText       String?
  answeredByAgent Boolean
  answeredById    String?
  answeredAt      DateTime?

  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  answeredBy Staff?    @relation(fields: [answeredById], references: [id], onDelete: Restrict)

  coveredThreadMemories WaThreadMemory[]
}

/// Two writers, disjoint column sets (08 §7). The webhook summarizer owns the
/// summary and coveredThrough columns; POS staff own the directive columns.
/// Neither may write the other's columns — that is what makes "the agent can
/// never overwrite a staff directive" structural rather than conventional.
/// (Never write a comment terminator inside a /// doc comment here: Prisma
/// copies it verbatim into the generated .d.ts and breaks the file.)
model WaThreadMemory {
  id                String    @id @default(cuid())
  /// wa_id
  from              String    @unique
  customerId        String?
  /// agent-owned
  summary           String?
  summaryAt         DateTime?
  summaryTurns      Int
  coveredThroughAt  DateTime?
  coveredThroughId  String?
  /// staff-owned
  directive         String?
  directiveAt       DateTime?
  directiveById     String?
  clarifyCount      Int
  clarifyAt         DateTime?
  updatedAt         DateTime

  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  coveredThrough WaMessage? @relation(fields: [coveredThroughId], references: [id], onDelete: Restrict)
  directiveBy    Staff?     @relation(fields: [directiveById], references: [id], onDelete: Restrict)
}

model AgentCache {
  id        String   @id @default(cuid())
  /// sha256(kind + q)
  key       String   @unique
  kind      String
  /// decision only — shape not ours
  value     Json
  createdAt DateTime
  expiresAt DateTime
  hits      Int
}

