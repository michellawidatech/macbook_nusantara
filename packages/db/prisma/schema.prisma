// ============================================================================
// The POS store on PostgreSQL — docs/store-on-postgres.md (2026-09-13)
//
// Every model below was a browser-only collection in apps/web/src/mock/seed.ts
// and marked ⚠️ there. Owner ask 2026-09-13: "Make all the POS screen read the
// Postgres not Mock." A list is a table, never a JSON column; a removal is a
// `removedAt`/`archivedAt`, never a DELETE.
// ============================================================================

/// A shelf inside a warehouse — "Rack 1". Settings-owned.
model Rack {
  id         String   @id @default(cuid())
  locationId String
  name       String
  active     Boolean
  sortOrder  Int
  createdAt  DateTime

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  units        Unit[]
  stockIns     StockIn[]
  opnameScopes OpnameScopeRack[]
}

/// Every reason a person can pick, per activity (owner decision 2026-08-24).
model Reason {
  id        String         @id @default(cuid())
  activity  ReasonActivity
  label     String
  active    Boolean
  sortOrder Int
  createdAt DateTime

  adjustments StockAdjustment[]
  stockMoves  StockMove[]

  @@unique([activity, label])
}

/// Who a sale is credited to. NOT `Staff`, which is a login.
model Salesperson {
  id        String   @id @default(cuid())
  name      String
  active    Boolean
  sortOrder Int
  createdAt DateTime

  orders Order[]
}

/// What QC inspects on a category of machine — "Screen", "Ports".
model GradingCriterion {
  id         String    @id @default(cuid())
  categoryId String
  name       String
  sortOrder  Int
  archivedAt DateTime?
  createdAt  DateTime

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  options     GradingOption[]
  ruleOptions GradingRuleOption[]
}

/// One entry of a criterion's dropdown — "Like new", "Dent or crack".
model GradingOption {
  id          String    @id @default(cuid())
  criterionId String
  label       String
  sortOrder   Int
  archivedAt  DateTime?

  criterion GradingCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  ruleOptions GradingRuleOption[]
}

/// One line of a category's grade table. `sortOrder` is evaluation order:
/// first fit wins, and a rule with no options is the catch-all.
model GradingRule {
  id         String    @id @default(cuid())
  categoryId String
  grade      Grade
  sortOrder  Int
  archivedAt DateTime?
  createdAt  DateTime

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  options GradingRuleOption[]
}

/// An option that satisfies one criterion of a rule. The options of one
/// criterion within one rule are that rule's condition on the criterion.
model GradingRuleOption {
  id          String    @id @default(cuid())
  ruleId      String
  criterionId String
  optionId    String
  sortOrder   Int
  removedAt   DateTime?

  rule      GradingRule      @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  criterion GradingCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)
  option    GradingOption    @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([ruleId, optionId])
}

/// A variant's value on one axis — `RAM = 8GB`. What the product code is built from.
model SkuAxisValue {
  id        String    @id @default(cuid())
  skuId     String
  axis      String
  value     String
  sortOrder Int
  removedAt DateTime?

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([skuId, axis])
}

/// An AppleDB model the shop hid from the import list, by AppleDB's key.
/// Unhiding sets `hidden = false`; the row stays.
model AppleDbHiddenModel {
  key       String   @id
  hidden    Boolean
  updatedAt DateTime
}

/// One QC decision, kept so Stock In history can say who accepted or
/// rejected a machine and when.
model StockIn {
  id              String             @id @default(cuid())
  unitId          String
  skuId           String
  purchaseOrderId String?
  locationId      String
  rackId          String?
  decision        StockInDecision
  rejectKind      StockInRejectKind?
  reason          String?
  buy             BigInt
  description     String?
  batteryHealth   Int?
  cycleCount      Int?
  fcc             Int?
  at              DateTime
  staffId         String

  unit          Unit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  sku           Sku            @relation(fields: [skuId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  location      Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  rack          Rack?          @relation(fields: [rackId], references: [id], onDelete: Restrict)
  staff         Staff          @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([unitId])
}

/// A logged stock adjustment, IN or OUT, entered in a batch.
model StockAdjustment {
  id            String         @id @default(cuid())
  unitId        String
  description   String
  reasonId      String
  at            DateTime
  staffId       String
  kind          AdjustmentKind
  batchId       String
  batteryHealth Int?
  cycleCount    Int?
  fcc           Int?
  /// The adjustment created the unit. Null on rows that never said.
  newUnit       Boolean?

  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  reason Reason @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([unitId])
}

/// One of a customer's delivery addresses (owner ask 2026-09-01).
model CustomerAddress {
  id         String    @id @default(cuid())
  customerId String
  label      String?
  line       String
  sortOrder  Int
  removedAt  DateTime?
  createdAt  DateTime

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
}

/// One named charge on a sale — the table CLAUDE.md predicted on 2026-08-27.
/// `Order.extra` stays the denormalised total.
model OrderFee {
  id        String    @id @default(cuid())
  orderId   String
  label     String
  amount    BigInt
  sortOrder Int
  removedAt DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

/// A machine coming back — from a customer (SG) or going back to a supplier (SP).
model UnitReturn {
  id             String           @id @default(cuid())
  code           String           @unique
  kind           ReturnKind
  unitId         String
  reason         String
  reasonDetail   String?
  /// YYYY-MM-DD.
  date           String
  status         UnitReturnStatus
  fromQc         Boolean?
  exchangeUnitId String?
  fee            BigInt?
  supplierId     String?
  expectedCredit BigInt?
  staffId        String
  createdAt      DateTime

  unit         Unit      @relation("UnitReturnUnit", fields: [unitId], references: [id], onDelete: Restrict)
  exchangeUnit Unit?     @relation("UnitReturnExchange", fields: [exchangeUnitId], references: [id], onDelete: Restrict)
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  staff        Staff     @relation(fields: [staffId], references: [id], onDelete: Restrict)

  unitEvents UnitEvent[]
}

/// Money out, entered by hand (owner ask 2026-09-01).
model Expense {
  id               String      @id @default(cuid())
  label            String?
  kind             ExpenseKind
  amount           BigInt
  /// YYYY-MM-DD.
  date             String
  note             String?
  referralSourceId String?
  methodId         String
  staffId          String
  /// The sale this is about, where the category needs one — a customer
  /// compensation, a refund (owner ask 2026-09-23).
  orderId          String?
  createdAt        DateTime

  referralSource ReferralSource? @relation(fields: [referralSourceId], references: [id], onDelete: Restrict)
  method         PaymentMethod   @relation(fields: [methodId], references: [id], onDelete: Restrict)
  staff          Staff           @relation(fields: [staffId], references: [id], onDelete: Restrict)
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

/// Money in that no sale accounts for (owner ask 2026-09-01).
model ManualIncome {
  id        String       @id @default(cuid())
  reason    IncomeReason
  amount    BigInt
  /// YYYY-MM-DD.
  date      String
  note      String?
  methodId  String
  staffId   String
  /// The sale or return this is about, where the category needs one — a
  /// supplier's refund credit (owner ask 2026-09-23).
  orderId   String?
  createdAt DateTime

  method PaymentMethod @relation(fields: [methodId], references: [id], onDelete: Restrict)
  staff  Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  order  Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

/// Every change ever made to a sale payment (owner ask 2026-09-08). Append-only.
model PaymentLog {
  id           String           @id @default(cuid())
  paymentId    String
  at           DateTime
  staffId      String
  action       PaymentLogAction
  beforeAmount BigInt?
  beforeStatus PayStatus?
  afterAmount  BigInt?
  afterStatus  PayStatus?
  reason       String?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Restrict)
}

/// A marketplace withdrawal, itemised (owner ask 2026-09-08).
model Settlement {
  id        String   @id @default(cuid())
  paymentId String
  orderId   String
  channel   Platform
  gross     BigInt
  received  BigInt
  reason    String?
  at        DateTime
  staffId   String

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Restrict)

  fees SettlementFee[]
  logs SettlementLog[]
}

model SettlementFee {
  id           String            @id @default(cuid())
  settlementId String
  kind         SettlementFeeKind
  label        String?
  amount       BigInt
  sortOrder    Int
  removedAt    DateTime?

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
}

/// Every change to a settlement. Append-only.
model SettlementLog {
  id             String              @id @default(cuid())
  settlementId   String
  at             DateTime
  staffId        String
  action         SettlementLogAction
  beforeReceived BigInt?
  beforeDeducted BigInt?
  afterReceived  BigInt?
  afterDeducted  BigInt?
  reason         String?

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Restrict)
}

/// A machine's trip to the repairer, and what it cost (owner ask 2026-09-08).
model ServiceVisit {
  id              String          @id @default(cuid())
  unitId          String
  fromLocationId  String
  openedAt        DateTime
  /// Signed for at the bench (owner ask 2026-09-09). Null while in transit.
  arrivedAt       DateTime?
  closedAt        DateTime?
  toLocationId    String?
  note            String?
  raisedBy        ServiceRaisedBy
  purchaseOrderId String?
  staffId         String

  unit          Unit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  fromLocation  Location       @relation("ServiceVisitFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation    Location?      @relation("ServiceVisitTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  staff         Staff          @relation(fields: [staffId], references: [id], onDelete: Restrict)

  fees ServiceFee[]
}

/// A charge on a service visit. Edited, never removed — zero says "quoted and not paid".
model ServiceFee {
  id        String         @id @default(cuid())
  visitId   String
  kind      ServiceFeeKind
  label     String?
  amount    BigInt
  at        DateTime
  staffId   String
  sortOrder Int

  visit ServiceVisit @relation(fields: [visitId], references: [id], onDelete: Restrict)
  staff Staff        @relation(fields: [staffId], references: [id], onDelete: Restrict)
}

/// Money paid to a supplier before anybody decided which invoice it settles.
model SupplierDeposit {
  id         String   @id @default(cuid())
  supplierId String
  amount     BigInt
  methodId   String
  at         DateTime
  note       String?
  staffId    String
  /// `Payment.inBalance` for the remainder of a payment larger than every
  /// invoice (owner 2026-09-22): it moved the balance exactly as the rest of
  /// that payment did, or did not.
  inBalance  Boolean  @default(true)

  supplier Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  method   PaymentMethod @relation(fields: [methodId], references: [id], onDelete: Restrict)
  staff    Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict)

  allocations DepositAllocation[]
  payments    Payment[]
}

/// Part of a deposit put against an invoice.
model DepositAllocation {
  id              String    @id @default(cuid())
  depositId       String
  purchaseOrderId String
  amount          BigInt
  at              DateTime
  staffId         String
  note            String?
  removedAt       DateTime?
  sortOrder       Int       @default(0)

  deposit       SupplierDeposit @relation(fields: [depositId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  staff         Staff           @relation(fields: [staffId], references: [id], onDelete: Restrict)
}

/// What a stock take covers (owner ask 2026-08-31). Every axis empty means all;
/// two join tables and not an array column, because JSON columns are forbidden.
model OpnameScopeLocation {
  id         String    @id @default(cuid())
  sessionId  String
  locationId String
  sortOrder  Int       @default(0)
  removedAt  DateTime?

  session  OpnameSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  location Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([sessionId, locationId])
}

model OpnameScopeRack {
  id        String    @id @default(cuid())
  sessionId String
  rackId    String
  sortOrder Int       @default(0)
  removedAt DateTime?

  session OpnameSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  rack    Rack          @relation(fields: [rackId], references: [id], onDelete: Restrict)

  @@unique([sessionId, rackId])
}

model OpnameScopeCategory {
  id         String    @id @default(cuid())
  sessionId  String
  categoryId String
  sortOrder  Int       @default(0)
  removedAt  DateTime?

  session  OpnameSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  category Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([sessionId, categoryId])
}

model OpnameScopeCondition {
  id        String        @id @default(cuid())
  sessionId String
  condition UnitCondition
  sortOrder Int           @default(0)
  removedAt DateTime?

  session OpnameSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, condition])
}

/// An unregistered machine a counter decided the shop should own. Acted on at POST.
model OpnameSurplus {
  id         String        @id @default(cuid())
  sessionId  String
  serial     String
  skuId      String
  locationId String
  reason     String
  condition  UnitCondition
  removedAt  DateTime?

  session  OpnameSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  sku      Sku           @relation(fields: [skuId], references: [id], onDelete: Restrict)
  location Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([sessionId, serial])
}

/// What changed, for browsers polling `/api/store/changes`. Written in the
/// same transaction as the row it names, by every writer in packages/db.
/// A technical log, not business history: rows older than the retention
/// window are pruned.
model StoreChange {
  id         BigInt   @id @default(autoincrement())
  collection String
  rowKey     String
  at         DateTime @default(now())

  @@index([at])
}

enum ReasonActivity {
  ADJUSTMENT
  RETURN_CUSTOMER
  RETURN_SUPPLIER
}

enum CatalogSource {
  MANUAL
  APPLEDB
}

enum StockInDecision {
  ACCEPTED
  REJECTED
}

enum StockInRejectKind {
  SUPPLIER
  SERVICE
}

enum AdjustmentKind {
  IN
  OUT
}

/// Sealed stock or second-hand — see apps/web/src/lib/condition.ts.
enum UnitCondition {
  NEW
  SECOND
}

enum ReturnKind {
  CUSTOMER
  SUPPLIER
}

enum UnitReturnStatus {
  PENDING
  ARRIVED
  DONE
  CANCELLED
}

enum ExpenseKind {
  OPERATIONAL
  PAYROLL
  MARKETING
  RENT
  // No longer offered by the adjustment picker (owner's list, 2026-09-23).
  // Kept so rows already written under them still read back.
  PROFESSIONAL
  SOFTWARE
  REFUND
  BUNGA
  SELISIH
  KOMPENSASI
  SUPPLIER
  TRANSFER
}

enum IncomeReason {
  SALES
  TRANSFER
  REFUND
  BUNGA
  SELISIH
}

enum PaymentLogAction {
  ADDED
  AMENDED
  REMOVED
}

enum SettlementFeeKind {
  COMMISSION
  SERVICE
  TRANSFER
  PROMOTION
  OTHER
}

enum SettlementLogAction {
  RECORDED
  AMENDED
  REOPENED
}

enum ServiceFeeKind {
  LABOUR
  PART
  SHIPPING
  OTHER
}

enum ServiceRaisedBy {
  QC
  ADJUSTMENT
  RETURN
}

/// Why a counted product's quantity moved (2026-09-19). See `StockMove`.
enum StockMoveType {
  MASUK
  MASUK_BATAL
  TERJUAL
  RETUR_PELANGGAN
  TUKAR_TAMBAH
  OPNAME
  KOREKSI
  /// Pieces sent back to the supplier (owner ask 2026-09-19). A move, not a
  /// `UnitReturn`: the SP code is `refCode`, the invoice they came in on is
  /// `purchaseOrderId`, and that invoice is what names the supplier.
  RETUR_SUPPLIER
}
