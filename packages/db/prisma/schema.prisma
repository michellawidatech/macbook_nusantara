  depositId       String
  purchaseOrderId String
  amount          BigInt
  at              DateTime
  staffId         String
  note            String?
  removedAt       DateTime?
  sortOrder       Int       @default(0)

  deposit       SupplierDeposit @relation(fields: [depositId], references: [id], onDelete: Restrict)
