  removedAt DateTime?

  session OpnameSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  rack    Rack          @relation(fields: [rackId], references: [id], onDelete: Restrict)

  @@unique([sessionId, rackId])
}

model OpnameScopeCategory {
  id         String    @id @default(cuid())
  sessionId  String
  categoryId String
  sortOrder  Int       @default(0)
  removedAt  DateTime?

  session  OpnameSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
