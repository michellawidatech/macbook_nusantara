/// Condition, not just cosmetic wear. A/B/C grade a preloved unit; NEW marks
/// factory-sealed stock (owner decision 2026-08-24, when the shop started
/// buying new alongside preloved). NEW is what lets intake skip QC: the unit
/// takes `Sku.price` and lands sellable, which `Unit_price_set_when_sellable`
/// already permits without a constraint change.
enum Grade {
  A
  B
  C
  NEW
}

enum UnitStatus {
  /// Owner decision 2026-08-15: arrival no longer makes a unit sellable.
  /// A unit lands in QC and only becomes TERSEDIA once staff record the
  /// description (UnitNote), serial and a non-zero asking price (Unit.price).
  QC
  TERSEDIA
  DIRESERVASI
  TERJUAL
  KLAIM_GARANSI
  RETUR_SUPPLIER
  REFUND_KLAIM
  HILANG
  KOREKSI_KELUAR
  /// At the repairer, or on its way (owner ask 2026-09-08).
  SERVIS
}

enum UnitEventType {
  DITERIMA
  /// QC passed: description + price recorded, unit enters sellable stock.
  QC_SELESAI
  DICATAT
  DIPINDAH
  DIRESERVASI
  RESERVASI_BATAL
  TERJUAL
  RETUR_PELANGGAN
  RETUR_SUPPLIER
  KLAIM_DIBUKA
  KLAIM_SELESAI
  REFUND
  OPNAME_HILANG
  OPNAME_DITEMUKAN
  KOREKSI
  /// A QC decision taken back (owner revision 2026-08-27). Staff accept the
  /// wrong machine into stock, or send the wrong one back to the supplier, and
  /// the ledger has to be able to say so: the decision that was wrong STAYS on
  /// the timeline and this arrow follows it, putting the unit back in QC.
