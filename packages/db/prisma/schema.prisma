model Staff {
  id                 String    @id @default(cuid())
  username           String    @unique
  name               String
  role               Role
  canApprove         Boolean
  active             Boolean
  passwordHash       String
  /// True while the account is on a password somebody else chose — the shop's
  /// initial password, or an owner's reset (owner ask 2026-09-18). A session
  /// of such an account can do nothing but choose a new one.
  mustChangePassword Boolean   @default(false)
  /// May open Financial & Report and read the money behind it — expenses,
  /// incomes, payouts and the payment edit logs (owner ask 2026-10-16: "only
  /// Ersen and Dina"). Per person rather than per role: Dina is staff, and
  /// making her an owner would also hand her everybody's passwords.
  canViewFinance     Boolean   @default(false)
  /// ⚠️ Dead since 2026-09-18, when Auth0 was retired for the app's own login.
  /// Kept for one release so the release before it still reads the table it
  /// expects through a deploy (docs/deploy-pipeline.md); drop it after that.
  auth0Sub           String?   @unique
  lastLoginAt        DateTime?
  createdAt          DateTime
  /// Signed-in account → default warehouse (owner rule: account A → warehouse X).
  defaultLocationId  String?

  defaultLocation Location? @relation("StaffDefaultLocation", fields: [defaultLocationId], references: [id], onDelete: Restrict)

  sessions                 StaffSession[]
  purchaseOrders           PurchaseOrder[]
  arrivalPhotos            ArrivalPhoto[]
  supplierReturns          SupplierReturn[]
  unitEvents               UnitEvent[]
  stockMoves               StockMove[]
  unitNotes                UnitNote[]
  opnameSessions           OpnameSession[]
  ordersApproved           Order[]               @relation("OrderApprovedBy")
  ordersSold               Order[]               @relation("OrderSoldBy")
  payments                 Payment[]
  orderAdjustments         OrderAdjustment[]
  shifts                   Shift[]
  shipmentEvents           ShipmentEvent[]
  warrantyClaims           WarrantyClaim[]
  priceLogs                PriceLog[]            @relation("PriceLogStaff")
  priceLogsApproved        PriceLog[]            @relation("PriceLogApprovedBy")
  priceReqsRequested       PriceReq[]            @relation("PriceReqRequestedBy")
  priceReqsDecided         PriceReq[]            @relation("PriceReqDecidedBy")
  auditLogs                AuditLog[]
  pettyCashEntries         PettyCashEntry[]
  waMessagesAnswered       WaMessage[]
  waThreadMemoriesDirected WaThreadMemory[]      @relation("WaThreadMemoryDirectedBy")
  waThreadMemoriesToggled  WaThreadMemory[]      @relation("WaThreadMemoryAutoReplyBy")
  idempotencyKeys          IdempotencyKey[]
  igCommentsReplied        IgComment[]           @relation("IgCommentRepliedBy")
  igCommentsDmSent         IgComment[]           @relation("IgCommentDmSentBy")
  agentKnowledge           AgentKnowledge[]
  personas                 Persona[]
  agentCorrections         AgentCorrection[]
  stockIns                 StockIn[]
  adjustments              StockAdjustment[]
  unitReturns              UnitReturn[]
  expenses                 Expense[]
  incomes                  ManualIncome[]
  paymentLogs              PaymentLog[]
  settlements              Settlement[]
  settlementLogs           SettlementLog[]
  serviceVisits            ServiceVisit[]
  serviceFees              ServiceFee[]
  deposits                 SupplierDeposit[]
  allocations              DepositAllocation[]
  chatActionsResolved      ChatAction[]          @relation("ChatActionResolvedBy")
  waThreadsLeadSet         WaThreadMemory[]      @relation("WaThreadMemoryLeadStaffBy")
  profileFacts             CustomerProfileFact[]
  evaluationsWritten       AgentEvaluation[]     @relation("AgentEvaluationCreatedBy")
  evaluationsReviewed      AgentEvaluation[]     @relation("AgentEvaluationReviewedBy")
}

model StaffSession {
  id        String    @id @default(cuid())
  staffId   String
  tokenHash String    @unique
  issuedAt  DateTime
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)
}

model Shift {
  id         String      @id @default(cuid())
  staffId    String
  locationId String
  status     ShiftStatus
  openedAt   DateTime
  closedAt   DateTime?
  openFloat  BigInt
  expected   BigInt
  declared   BigInt
  variance   BigInt

  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  orders           Order[]
  payments         Payment[]
  adjustments      OrderAdjustment[]
  pettyCashEntries PettyCashEntry[]
}

// ============================================================================
// Reservations
// ============================================================================

/// Which channel a hold came in over — Instagram, WhatsApp, TikTok, Shopee,
/// Tokopedia, Walk-in. A managed list, edited in Settings.
///
/// NOT `ReferralSource`, which answers "which ad drove this" (Instagram Ads,
/// Friends) for a customer and for an order — "Walk-in" is never an answer to
/// that question. And NOT `ResSource`, which answers "did a person or the bot
/// create this hold". Three different questions; conflating any two of them
/// loses information the shop uses (owner decision 2026-08-28).
model ReservationSource {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime

  reservations Reservation[]
}

model Reservation {
  id                  String            @id @default(cuid())
  code                String            @unique @default(dbgenerated("next_doc_code('RV'::text)"))
  customerId          String?
  custName            String?
  phone               String?
  scheduledFor        DateTime?
  status              ReservationStatus
  source              ResSource
  /// The channel the customer contacted the shop over. Nullable: holds created
  /// by the agent have no channel list entry, and rows predate the column.
  reservationSourceId String?
  note                String?
  createdAt           DateTime

  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  reservationSource ReservationSource? @relation(fields: [reservationSourceId], references: [id], onDelete: Restrict)

  items      ReservationItem[]
  unitEvents UnitEvent[]
  orders     Order[]
  /// The chatbot's confirmed proposal, when the bot made this booking.
  proposal   ReservationProposal?

  /// The agent's duplicate guard and the phone-scoped cancel both read
  /// (phone, status) on every booking attempt.
  @@index([phone, status])
  @@index([reservationSourceId])
}

model ReservationItem {
  id            String    @id @default(cuid())
  reservationId String
  skuId         String?
  unitId        String?
  qty           Int
  note          String?
  /// Let go of while the rest of the hold stays (owner revision 2026-08-26).
  removedAt     DateTime?
  sortOrder     Int       @default(0)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  sku         Sku?        @relation(fields: [skuId], references: [id], onDelete: Restrict)
  unit        Unit?       @relation(fields: [unitId], references: [id], onDelete: Restrict)

  /// Every hold read traverses items — the list, the release, the projection,
  /// the expiry sweep. Prisma does not index a foreign key on Postgres, and
  /// this table had no index at all.
  @@index([reservationId])
}

