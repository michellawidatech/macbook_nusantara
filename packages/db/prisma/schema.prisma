// Macbook Nusantara — database schema
//
// Source of truth: docs/erd-pos-chatbot.drawio (62 tables, 34 enums).
// Contract:        docs/rebuild/08-data-integrity.md, docs/rebuild/01-conventions.md §6
//
// Rules this file obeys:
//   - The serial number is the subject of this database. Every unit state
//     change is an append-only UnitEvent row; Unit.status and Unit.locationId
//     are projections written in the same transaction (08 §1, §4).
//   - Every relation is a declared foreign key with an explicit onDelete.
//     onDelete is Restrict everywhere, because nothing in this system is ever
//     hard-deleted (01 §6, 08 §2 invariant 15). Cascade would be the mechanism
//     by which rows do get deleted; SetNull would silently erase history.
//   - Money is BigInt whole rupiah. Ids are String cuid. Calendar days are
//     String "YYYY-MM-DD" (Asia/Jakarta).
//
// Constraints Prisma cannot express — CHECK, partial unique indexes, table
// grants — are NOT in this file. They belong in a `--create-only` migration
// (08 §2). Where the ERD marks one, it is noted in a comment below.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Stock locations and suppliers
// ============================================================================

model Location {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  kind      LocationKind
  address   String?
  active    Boolean
  sortOrder Int

  purchaseOrders PurchaseOrder[]
  units          Unit[]
  unitEventsFrom UnitEvent[]           @relation("UnitEventFromLocation")
  unitEventsTo   UnitEvent[]           @relation("UnitEventToLocation")
  opnameSessions OpnameSession[]
  orders         Order[]
  shifts         Shift[]
  racks          Rack[]
  stockIns       StockIn[]
  opnameScopes   OpnameScopeLocation[]
  opnameSurplus  OpnameSurplus[]
  serviceFrom    ServiceVisit[]        @relation("ServiceVisitFrom")
  serviceTo      ServiceVisit[]        @relation("ServiceVisitTo")
  staffDefaults  Staff[]               @relation("StaffDefaultLocation")
}

model Supplier {
  id               String    @id @default(cuid())
  name             String    @unique
  wa               String?
  note             String?
  active           Boolean
  createdAt        DateTime
  /// The two-letter origin code in front of the store barcode (owner ask
  /// 2026-08-28). Nullable: every supplier before the scheme has none.
  code             String?   @unique @db.Char(2)
  address          String?
  /// What the shop owed this supplier before this system existed (owner ask
  /// 2026-09-08). Null means never stated, which is not the same fact as 0.
  openingBalance   BigInt?
  openingBalanceAt DateTime?

  purchaseOrders  PurchaseOrder[]
  supplierReturns SupplierReturn[]
  warrantyClaims  WarrantyClaim[]
  unitReturns     UnitReturn[]
  deposits        SupplierDeposit[]
}

// ============================================================================
// Purchase orders and goods arrival
// ============================================================================

model PurchaseOrder {
  id         String    @id @default(cuid())
  code       String    @unique @default(dbgenerated("next_doc_code('PI'::text)"))
  supplierId String
  invoice    String?
  noInvoice  Boolean
  status     POStatus
  orderedAt  DateTime
  receivedAt DateTime?
  /// When somebody said this invoice is finished with (owner revision
  /// 2026-08-27). Separate from `status`, which is about the GOODS: an order
  /// can be fully received and still open because the ongkir has not been
  /// settled, and it can be closed with a line the supplier never sent.
  /// Closing makes the order read-only and takes it out of the shop's live
  /// work. Reversible on purpose — it is a filing decision, not a state
  /// change, and an intake screen must never make a mistake permanent.
  closedAt   DateTime?
  subtotal   BigInt
  feesTaxPct Decimal   @db.Decimal(5, 2)
  feesTotal  BigInt
  total      BigInt
  /// Negotiated off the whole invoice. `total` is subtotal + fees - discount.
  discount   BigInt    @default(0)
  locationId String
  staffId    String
  note       String?
  createdAt  DateTime

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)

  items           PurchaseOrderItem[]
  fees            PurchaseOrderFee[]
  packages        PurchaseOrderPackage[]
  arrivalPhotos   ArrivalPhoto[]
  supplierReturns SupplierReturn[]
  payments        Payment[]
  unitEvents      UnitEvent[]
  unitsBought     Unit[]                 @relation("UnitPurchaseOrder")
  stockIns        StockIn[]
  serviceVisits   ServiceVisit[]
  allocations     DepositAllocation[]
}

model PurchaseOrderItem {
  id           String    @id @default(cuid())
  poId         String
  skuId        String?
  produk       String
  spec         String?
  qty          Int
  unitCost     BigInt
  lineTotal    BigInt
  allocatedFee BigInt
  /// The supplier never sent it. Still counts towards what was INVOICED.
  notReceived  Boolean   @default(false)
  removedAt    DateTime?
  sortOrder    Int       @default(0)

  po  PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Restrict)
  sku Sku?          @relation(fields: [skuId], references: [id], onDelete: Restrict)

  serials PurchaseOrderItemSerial[]
  units   Unit[]
}

model PurchaseOrderItemSerial {
  id     String  @id @default(cuid())
  itemId String
  serial String
  unitId String?

  item PurchaseOrderItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  unit Unit?             @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([itemId, serial])
}

model PurchaseOrderFee {
  id     String  @id @default(cuid())
  poId   String
  label  String
  kind   FeeKind
  amount BigInt

  po PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Restrict)
}

model PurchaseOrderPackage {
  id         String  @id @default(cuid())
  poId       String
  label      String
  qty        Int
  weightGram Int?
  note       String?

  po PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Restrict)
}

model ArrivalPhoto {
  id      String   @id @default(cuid())
  poId    String
  url     String
  takenAt DateTime
  staffId String

  po    PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Restrict)
  staff Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict)
}

model SupplierReturn {
  id         String       @id @default(cuid())
  code       String       @unique @default(dbgenerated("next_doc_code('SP'::text)"))
  supplierId String
  poId       String?
  status     ReturnStatus
  reason     String?
  staffId    String
  createdAt  DateTime

  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  po       PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: Restrict)
  staff    Staff          @relation(fields: [staffId], references: [id], onDelete: Restrict)

  items SupplierReturnItem[]
}

model SupplierReturnItem {
  id       String  @id @default(cuid())
  returnId String
  unitId   String
  amount   BigInt
  note     String?

  supplierReturn SupplierReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)
  unit           Unit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
}

// ============================================================================
// Catalogue: category → model → sku
// ============================================================================

model Category {
  id           String     @id @default(cuid())
  name         String     @unique
  sortOrder    Int
  marginMode   MarginMode
  marginMin    BigInt
  marginMax    BigInt
  createdAt    DateTime
  /// Is a machine of this category identified one by one?
  ///
  /// False for the categories the shop counts rather than tracks — accessories
  /// above all (owner ask 2026-09-15: "Accessories do not have serial number,
  /// and in stock opname, they will only be counted and validated by qty, not
  /// serial"). A `Unit` row still exists per item, because that is what carries
  /// what it cost and what became of it; what changes is that nothing ASKS for
  /// a serial, QC accepts a unit without one, and a stock take counts them.
  ///
  /// Per category rather than per model, so a shop that starts counting cables
  /// says so once. Default true: every category that existed before this
  /// column is one the shop was already tracking by serial.
  tracksSerial Boolean    @default(true)

  attributes   CategoryAttribute[]
  variantAxes  CategoryVariantAxis[]
  models       CatalogModel[]
  discounts    Discount[]
  grading      GradingCriterion[]
  gradeRules   GradingRule[]
  opnameScopes OpnameScopeCategory[]
}

model CategoryAttribute {
  id         String   @id @default(cuid())
  categoryId String
  key        String
  label      String
  type       AttrType
  unit       String?
  sortOrder  Int

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  options        CategoryAttributeOption[]
  unitAttributes UnitAttribute[]

  @@unique([categoryId, key])
}

model CategoryAttributeOption {
  id          String @id @default(cuid())
  attributeId String
  value       String
  sortOrder   Int

  attribute CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)
}

model CategoryVariantAxis {
  id         String @id @default(cuid())
  categoryId String
  name       String
  sortOrder  Int

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
}

model CatalogModel {
  id         String         @id @default(cuid())
  categoryId String
  name       String
  year       String?
  /// Short line code for the printed label — "PRO", "AIR". Model-level because
  /// it is what the model *is*, unlike chip or touch bar, which differ between
  /// units of one model and are therefore variant axes (owner decision
  /// 2026-08-24). Null for anything with no line distinction, like an iPad.
  line       String?
  /// Screen size in inches, for the label. Decimal because the older Pros are
  /// genuinely 13.3", not 13 — rendered with the trailing .0 trimmed.
  sizeInch   Decimal?       @db.Decimal(3, 1)
  /// Apple's model identifier when the row came from AppleDB (e.g. Mac14,2).
  identifier String?
  source     CatalogSource?
  archived   Boolean
  createdAt  DateTime

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  axes      ModelAxis[]
  photos    ModelPhoto[]
  skus      Sku[]
  discounts Discount[]

  @@unique([categoryId, name, year])
}

model ModelAxis {
  id        String    @id @default(cuid())
  modelId   String
  name      String
  sortOrder Int
  removedAt DateTime?

  model CatalogModel @relation(fields: [modelId], references: [id], onDelete: Restrict)

  values ModelAxisValue[]
}

model ModelAxisValue {
  id        String    @id @default(cuid())
  axisId    String
  value     String
  sortOrder Int
  removedAt DateTime?

  axis ModelAxis @relation(fields: [axisId], references: [id], onDelete: Restrict)
}

model ModelPhoto {
  id        String @id @default(cuid())
  modelId   String
  url       String
  sortOrder Int

  model CatalogModel @relation(fields: [modelId], references: [id], onDelete: Restrict)
}

model Sku {
  id           String   @id @default(cuid())
  modelId      String
  code         String   @unique
  name         String
  variantLabel String?
  grade        Grade?
  /// The sellable price, and since 2026-08-27 the only one. Every unit of this
  /// variant asks this. Nothing on Unit overrides it.
  price        BigInt
  landed       BigInt
  archived     Boolean
  createdAt    DateTime

  model CatalogModel @relation(fields: [modelId], references: [id], onDelete: Restrict)

  units            Unit[]
  poItems          PurchaseOrderItem[]
  orderItems       OrderItem[]
  reservationItems ReservationItem[]
  discountSkus     DiscountSku[]
  priceLogs        PriceLog[]
  priceReqs        PriceReq[]
  axisValues       SkuAxisValue[]
  stockIns         StockIn[]
  tradeIns         TradeIn[]
  opnameSurplus    OpnameSurplus[]
  opnameCounts     OpnameCount[]
}

// ============================================================================
// Units — the subject of this database (08 §1)
// ============================================================================

model Unit {
  id              String     @id @default(cuid())
  serial          String     @unique
  skuId           String
  /// projection of the unit's event stream — never updated alone (08 §1)
  status          UnitStatus
  /// projection of the unit's event stream — never updated alone (08 §1)
  locationId      String
  /// What this machine cost the shop, and what it cost landed. Per-serial and
  /// staying that way: the asking price moved to Sku.price on 2026-08-27, but
  /// what was PAID for one particular unit is what every margin is computed
  /// against and is a fact about the serial, not about the variant.
  buy             BigInt
  landed          BigInt
  /// Recorded at QC, shown in Inventory, and deliberately NOT a price input
  /// (owner decision 2026-08-27). Two units of one variant ask the same money
  /// whatever their grade.
  grade           Grade?
  /// What QC saw: a comma-joined list of phrases, each picked from
  /// `QcDescription` or free-typed. FREE TEXT and staying that way — a machine
  /// turns up with a mark nobody has seen before, and `QcDescription` is the
  /// suggestion list that field offers, not a controlled vocabulary. Making it
  /// one, so Inventory could filter on "has a dent", is a separate owner
  /// decision (CLAUDE.md).
  ///
  /// Nullable because sealed stock has nothing to describe: a New unit needs no
  /// description and the QC grid does not ask for one (owner decision
  /// 2026-08-28). For a second-hand unit the description is what gates
  /// acceptance, and that rule lives in `lib/inboundQc.ts`, not in a NOT NULL —
  /// the column also has to hold the pre-2026-09-02 units, which have none.
  description     String?
  /// Which shelf, once QC accepts it into stock.
  rackId          String?
  /// What THIS machine asks over the counter (owner revision 2026-09-08,
  /// reversing 2026-08-27). Null quotes `Sku.price`.
  price           BigInt?
  /// The marketplace listing when somebody overrode the markup rule.
  marketPrice     BigInt?
  /// The invoice it came in on, when it came in on one.
  purchaseOrderId String?
  poItemId        String?
  soldOrderItemId String?
  intakeAt        DateTime
  archivedAt      DateTime?
  /// optimistic lock
  version         Int

  sku           Sku                @relation(fields: [skuId], references: [id], onDelete: Restrict)
  location      Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  poItem        PurchaseOrderItem? @relation(fields: [poItemId], references: [id], onDelete: Restrict)
  soldOrderItem OrderItem?         @relation("UnitSoldOrderItem", fields: [soldOrderItemId], references: [id], onDelete: Restrict)
  rack          Rack?              @relation(fields: [rackId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?     @relation("UnitPurchaseOrder", fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  attributes          UnitAttribute[]
  events              UnitEvent[]
  notes               UnitNote[]
  poItemSerials       PurchaseOrderItemSerial[]
  supplierReturnItems SupplierReturnItem[]
  opnameScans         OpnameScan[]
  orderItems          OrderItem[]               @relation("OrderItemUnit")
  tradeIns            TradeIn[]
  reservationItems    ReservationItem[]
  warrantyClaims      WarrantyClaim[]
  stockIns            StockIn[]
  adjustments         StockAdjustment[]
  returns             UnitReturn[]              @relation("UnitReturnUnit")
  exchanges           UnitReturn[]              @relation("UnitReturnExchange")
  serviceVisits       ServiceVisit[]
}

model UnitAttribute {
  id          String @id @default(cuid())
  unitId      String
  attributeId String
  value       String

  unit      Unit              @relation(fields: [unitId], references: [id], onDelete: Restrict)
  attribute CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@unique([unitId, attributeId])
}

/// Append-only ledger. One row per unit state change, written in the same
/// transaction as the projection it updates (08 §1, §4). Never updated,
/// never deleted — the app DB role has INSERT only (08 §9).
model UnitEvent {
  id              String        @id @default(cuid())
  unitId          String
  /// immutable copy — history reads correctly even if Unit is archived (08 §4)
  serial          String
  /// Document number, e.g. TX-2026/08-000001. Only a DIPINDAH event carries
  /// one: a stock transfer is the one movement the shop numbers by hand, and
  /// the ERD gives it no document of its own. Filled by the application from
  /// next_doc_code('TX'), not by a column default, because a default cannot be
  /// conditional on the event type. Added in S9 follow-up with the owner's
  /// approval; docs/erd-pos-chatbot.drawio updated in the same commit.
  code            String?       @unique
  seq             Int
  type            UnitEventType
  at              DateTime
  fromStatus      UnitStatus?
  toStatus        UnitStatus
  fromLocationId  String?
  toLocationId    String?
  orderId         String?
  purchaseOrderId String?
  claimId         String?
  opnameSessionId String?
  /// Which hold this event belongs to, on DIRESERVASI and RESERVASI_BATAL.
  ///
  /// Without it the S/N timeline re-joins a hold to an event by serial and
  /// takes the first match, so a machine held, released, then held again by a
  /// different customer narrates the wrong person on both events. It is also
  /// what makes "which hold is holding this unit" answerable from the ledger
  /// rather than from a second copy on ReservationItem that would go stale.
  reservationId   String?
  /// The customer or supplier return this event belongs to.
  unitReturnId    String?
  costDelta       BigInt
  staffId         String
  requestId       String?
  note            String?

  unit          Unit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  fromLocation  Location?      @relation("UnitEventFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation    Location?      @relation("UnitEventToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  claim         WarrantyClaim? @relation(fields: [claimId], references: [id], onDelete: Restrict)
  opnameSession OpnameSession? @relation(fields: [opnameSessionId], references: [id], onDelete: Restrict)
  reservation   Reservation?   @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  unitReturn    UnitReturn?    @relation(fields: [unitReturnId], references: [id], onDelete: Restrict)
  staff         Staff          @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([unitId, seq])
  @@index([reservationId])
}

model UnitNote {
  id      String   @id @default(cuid())
  unitId  String
  /// immutable copy
  serial  String
  body    String
  tag     String?
  staffId String
  at      DateTime

  unit  Unit  @relation(fields: [unitId], references: [id], onDelete: Restrict)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)

  photos UnitNotePhoto[]
}

model UnitNotePhoto {
  id          String  @id @default(cuid())
  noteId      String
  url         String
  sortOrder   Int
  /// The image itself, when it was uploaded rather than linked. In the
  /// database so the nightly dump carries it and the sale purge deletes row
  /// and file in one statement (CLAUDE.md's sanctioned exception).
  data        Bytes?
  contentType String?

  note UnitNote @relation(fields: [noteId], references: [id], onDelete: Restrict)
}

// ============================================================================
// Stock opname
// ============================================================================

model OpnameSession {
  id         String       @id @default(cuid())
  code       String       @unique @default(dbgenerated("next_doc_code('SO'::text)"))
  /// What staff typed to tell two counts of one warehouse apart — "rak A-C,
  /// shift pagi". Nullable because `code` is the identifier; this is only a
  /// human hint (owner decision 2026-08-24).
  label      String?
  locationId String
  status     OpnameStatus
  /// The day being counted FOR, chosen in the start dialog. YYYY-MM-DD.
  countDate  String?
  startedAt  DateTime
  closedAt   DateTime?
  staffId    String

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)

  scans           OpnameScan[]
  unitEvents      UnitEvent[]
  scopeLocations  OpnameScopeLocation[]
  scopeRacks      OpnameScopeRack[]
  scopeCategories OpnameScopeCategory[]
  scopeConditions OpnameScopeCondition[]
  surplus         OpnameSurplus[]
  counts          OpnameCount[]
}

/// What a stock take found of a product it counts rather than scans.
///
/// Accessories have no serial anybody reads (owner ask 2026-09-15 —
/// `Category.tracksSerial`), so a count of them is a NUMBER: one row per
/// variant in scope, holding how many were on the shelf. A variant the counter
/// never got to has no row, which is not the same fact as a row saying zero —
/// zero means somebody looked and found none.
model OpnameCount {
  id        String    @id @default(cuid())
  sessionId String
  skuId     String
  /// How many were found. Zero is a real answer.
  qty       Int
  sortOrder Int       @default(0)
  removedAt DateTime?

  session OpnameSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  sku     Sku           @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([sessionId, skuId])
}

model OpnameScan {
  id        String     @id @default(cuid())
  sessionId String
  serial    String
  unitId    String?
  result    ScanResult
  at        DateTime
  /// What the counter wrote about a missing or unexpected machine.
  note      String?
  sortOrder Int        @default(0)
  removedAt DateTime?

  session OpnameSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  unit    Unit?         @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([sessionId, serial])
}

// ============================================================================
// Customers and sales
// ============================================================================

/// A phrase QC reaches for when describing a machine — "Mulus", "Lecet di
/// casing bawah", "Fullset dus" (owner revision 2026-08-27).
///
/// A lookup table for the same reason `ReferralSource` is one: the shop adds a
/// phrase without waiting for a migration. Never hard-deleted — deactivate.
///
/// ⚠️ Nothing has a foreign key to this, and that is deliberate rather than an
/// oversight of 01 §6. `Unit.description` is FREE TEXT and has to stay free
/// text: a second-hand machine turns up with a mark nobody has seen before and
/// the person grading it has to be able to say so. This table is the
/// suggestion list that field offers — one row per phrase the shop has
/// actually used, joined by the application with ", " into the sentence the
/// column stores — so there is no link here to declare, loose or otherwise.
/// Making descriptions a controlled vocabulary (a Unit↔QcDescription join, so
/// Inventory could filter on "has a dent") is a bigger change and a separate
/// owner decision.
model QcDescription {
  id        String   @id @default(cuid())
  label     String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime
}

/// Where a customer or an order came from — "Instagram Ads", "Friends".
/// A lookup table rather than an enum so staff can add rows without a
/// migration (owner decision 2026-08-15). Never hard-deleted: deactivate.
model ReferralSource {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime

  customers Customer[]
  orders    Order[]
  expenses  Expense[]
}

model Customer {
  id               String    @id @default(cuid())
  name             String
  /// E.164. Nullable since 2026-09-13: the B2Soft import has no numbers,
  /// and staff fill them in (owner answer). Unique still — NULLs never clash.
  phone            String?   @unique
  email            String?
  street           String?
  zip              String?
  note             String?
  /// How this customer first heard of the store.
  referralSourceId String?
  createdAt        DateTime
  /// A balance from before this system that no invoice explains (the
  /// 2026-09-13 receivables audit). Null means never stated.
  openingBalance   BigInt?
  openingBalanceAt DateTime?

  postalCode     PostalCode?     @relation(fields: [zip], references: [zip], onDelete: Restrict)
  referralSource ReferralSource? @relation(fields: [referralSourceId], references: [id], onDelete: Restrict)

  orders           Order[]
  reservations     Reservation[]
  waMessages       WaMessage[]
  waThreadMemories WaThreadMemory[]
  addresses        CustomerAddress[]
}

model Order {
  id               String      @id @default(cuid())
  code             String      @unique @default(dbgenerated("next_doc_code('SI'::text)"))
  ts               DateTime
  customerId       String?
  custName         String?
  phone            String?
  platform         Platform
  fulfill          Fulfillment
  status           OrderStatus
  subtotal         BigInt
  discountId       String?
  discount         BigInt
  extra            BigInt
  extraNote        String?
  total            BigInt
  /// = Σ Payment
  paidTotal        BigInt
  cogs             BigInt
  tradeCredit      BigInt
  belowFloor       Boolean
  ovReason         String?
  approvedById     String?
  soldById         String
  shiftId          String?
  locationId       String
  /// Which ad/channel drove this sale (owner decision 2026-08-15).
  referralSourceId String?
  /// Who is credited with the sale — not the login that rang it up.
  salespersonId    String?
  shippingAddress  String?
  /// The headline payment method; each part's own is on `Payment`.
  payMethodId      String?
  /// What the sale was worth before a marketplace took its cut.
  grossTotal       BigInt?
  netReceived      BigInt?
  /// The hold this sale came out of, if any.
  reservationId    String?

  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Relation field is `discountRef` because the scalar column `discount`
  // (BigInt, the rupiah amount) already owns the name `discount`.
  discountRef    Discount?       @relation(fields: [discountId], references: [id], onDelete: Restrict)
  approvedBy     Staff?          @relation("OrderApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  soldBy         Staff           @relation("OrderSoldBy", fields: [soldById], references: [id], onDelete: Restrict)
  shift          Shift?          @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  location       Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  referralSource ReferralSource? @relation(fields: [referralSourceId], references: [id], onDelete: Restrict)
  salesperson    Salesperson?    @relation(fields: [salespersonId], references: [id], onDelete: Restrict)
  payMethod      PaymentMethod?  @relation(fields: [payMethodId], references: [id], onDelete: Restrict)
  reservation    Reservation?    @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  items       OrderItem[]
  tradeIns    TradeIn[]
  payments    Payment[]
  adjustments OrderAdjustment[]
  shipments   Shipment[]
  unitEvents  UnitEvent[]
  fees        OrderFee[]
  settlements Settlement[]
}

model OrderItem {
  id           String    @id @default(cuid())
  orderId      String
  unitId       String?
  skuId        String
  /// snapshot
  name         String
  /// snapshot
  variant      String?
  qty          Int
  price        BigInt
  sub          BigInt
  /// snapshot
  cogs         BigInt
  /// What the serial was LISTED at when sold — a snapshot (owner ask 2026-09-01).
  listPrice    BigInt?
  garansiUntil DateTime?
  returnedQty  Int
  returnedAt   DateTime?
  returnReason String?
  /// Where the line sits on the receipt.
  sortOrder    Int       @default(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  unit  Unit? @relation("OrderItemUnit", fields: [unitId], references: [id], onDelete: Restrict)
  sku   Sku   @relation(fields: [skuId], references: [id], onDelete: Restrict)

  unitsSold      Unit[]          @relation("UnitSoldOrderItem")
  shipmentItems  ShipmentItem[]
  warrantyClaims WarrantyClaim[]
}

model TradeIn {
  id        String         @id @default(cuid())
  orderId   String
  label     String
  serial    String?
  value     BigInt
  unitId    String?
  note      String?
  skuId     String?
  condition UnitCondition?
  grade     Grade?
  removedAt DateTime?
  sortOrder Int            @default(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  unit  Unit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  sku   Sku?  @relation(fields: [skuId], references: [id], onDelete: Restrict)
}

/// CHECK (amount > 0) and CHECK ((orderId IS NULL) <> (poId IS NULL)) —
/// invariants 6 and 7 — are hand-written in a --create-only migration (08 §2).
model Payment {
  id            String       @id @default(cuid())
  orderId       String?
  poId          String?
  direction     PayDirection
  methodId      String
  amount        BigInt
  /// Which part of the bill this transfer settles (owner revision
  /// 2026-08-27). Shipping is usually a different party from the supplier — a
  /// forwarder paid on its own day — and tax is a third, so one
  /// undifferentiated "paid" figure could not answer the only question the
  /// Purchase card is ever asked: *has the ongkir been settled?*
  ///
  /// Defaults to BARANG, and the default is the honest reading of history
  /// rather than a placeholder: shipping and tax were separate figures on an
  /// order long before anyone could pay them separately, so every payment
  /// recorded before this column existed was against the goods. A customer
  /// paying at the till is BARANG too — the buckets only differ on the
  /// supplier side.
  appliedTo     PayTarget    @default(BARANG)
  status        PayStatus
  paidAt        DateTime?
  dueAt         DateTime?
  ref           String?
  staffId       String
  shiftId       String?
  /// Which marketplace holds a PENDING part (owner ask 2026-09-08).
  channel       Platform?
  note          String?
  /// When the part was recorded — `paidAt` is only for money that landed.
  recordedAt    DateTime?
  /// The supplier deposit this payment was allocated out of.
  fromDepositId String?
  /// Removed in an edit. Never deleted; the payment log says why.
  voidedAt      DateTime?
  /// Order among one sale's or one invoice's payments.
  sortOrder     Int          @default(0)

  order       Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  po          PurchaseOrder?   @relation(fields: [poId], references: [id], onDelete: Restrict)
  staff       Staff            @relation(fields: [staffId], references: [id], onDelete: Restrict)
  shift       Shift?           @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  method      PaymentMethod    @relation(fields: [methodId], references: [id], onDelete: Restrict)
  fromDeposit SupplierDeposit? @relation(fields: [fromDepositId], references: [id], onDelete: Restrict)

  logs        PaymentLog[]
  settlements Settlement[]

  // Declared, not just created in SQL: an index that exists in the database
  // but not here is one Prisma emits a DROP for on the next migration.
  @@index([methodId])
}

/// How money moved. A lookup table rather than an enum for the same reason
/// ReferralSource is one: the shop adds a method without waiting for a
/// migration (owner decision 2026-08-24). Never hard-deleted — deactivate.
///
/// `builtIn` marks a row the application reasons about by `code` rather than
/// by label: MARKETPLACE is what puts Shopee money in escrow until a
/// withdrawal is confirmed. Staff may rename or deactivate a built-in, never
/// delete it, so that logic can never be left pointing at nothing.
///
/// `forPo` and `forSale` are separate because the two sides genuinely differ:
/// a supplier is paid in cash, card or deposit, while a customer can also pay
/// by QRIS or leave the money in a marketplace escrow.
model PaymentMethod {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  builtIn   Boolean
  forPo     Boolean
  forSale   Boolean
  active    Boolean
  sortOrder Int
  createdAt DateTime

  payments Payment[]
  orders   Order[]
  expenses Expense[]
  incomes  ManualIncome[]
  deposits SupplierDeposit[]
}

model OrderAdjustment {
  id      String     @id @default(cuid())
  /// Document number. Only a RETUR adjustment carries one — SG-2026/08-000001,
  /// the shop's "surat ganti" for a customer return — filled by the return
  /// flow (Increment 4) from next_doc_code('SG'), not by a column default,
  /// because a default cannot be conditional on `type`. VOID and REFUND stay
  /// unnumbered by the owner's decision (S9 follow-up). ERD updated in the
  /// same commit.
  code    String?    @unique
  orderId String
  type    AdjustType
  amount  BigInt
  reason  String
  at      DateTime
  staffId String
  shiftId String?

  order Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  staff Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)
  shift Shift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)
}

model Discount {
  id            String    @id @default(cuid())
  code          String    @unique
  /// PCT uses pct (+ optional maxRp cap); NOMINAL uses amountRp. Exactly one
  /// side is populated — enforced by CHECK discount_type_fields.
  type          DiscType
  pct           Int?
  amountRp      BigInt?
  maxRp         BigInt?
  minRp         BigInt?
  description   String?
  usageLimit    Int?
  used          Int
  fromDate      DateTime?
  toDate        DateTime?
  active        Boolean
  scope         DiscScope
  categoryId    String?
  /// BUNDLE only: how many qualifying units make one bundle, and its price.
  bundleQty     Int?
  bundlePriceRp BigInt?
  /// PRODUK scope: the model the discount applies to.
  modelId       String?

  category Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  model    CatalogModel? @relation(fields: [modelId], references: [id], onDelete: Restrict)

  skus   DiscountSku[]
  orders Order[]
}

model DiscountSku {
  id         String @id @default(cuid())
  discountId String
  skuId      String

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)
  sku      Sku      @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([discountId, skuId])
}

