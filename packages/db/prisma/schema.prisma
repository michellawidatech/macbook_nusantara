  C
  NEW
}

enum UnitStatus {
  /// Owner decision 2026-08-15: arrival no longer makes a unit sellable.
  /// A unit lands in QC and only becomes TERSEDIA once staff record the
  /// description (UnitNote), serial and a non-zero asking price (Unit.price).
  QC
  TERSEDIA
  DIRESERVASI
  TERJUAL
  KLAIM_GARANSI
  RETUR_SUPPLIER
  REFUND_KLAIM
  HILANG
  KOREKSI_KELUAR
}

enum UnitEventType {
  DITERIMA
  /// QC passed: description + price recorded, unit enters sellable stock.
  QC_SELESAI
  DICATAT
  DIPINDAH
  DIRESERVASI
  RESERVASI_BATAL
  TERJUAL
  RETUR_PELANGGAN
  RETUR_SUPPLIER
  KLAIM_DIBUKA
  KLAIM_SELESAI
  REFUND
  OPNAME_HILANG
  OPNAME_DITEMUKAN
  KOREKSI
  /// A QC decision taken back (owner revision 2026-08-27). Staff accept the
  /// wrong machine into stock, or send the wrong one back to the supplier, and
  /// the ledger has to be able to say so: the decision that was wrong STAYS on
  /// the timeline and this arrow follows it, putting the unit back in QC.
  ///
  /// Its own type rather than KOREKSI, for two reasons. A timeline reading
  /// "Adjustment" does not tell the next person what happened, and KOREKSI
  /// already has an arrow out of both QC and TERSEDIA — to KOREKSI_KELUAR —
  /// so a second meaning for the same (from, type) pair would make
