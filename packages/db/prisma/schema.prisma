// ============================================================================
// WhatsApp
// ============================================================================

/// Persisted verbatim before Meta is acked, so a crash mid-pipeline loses
/// nothing (08 §5).
model WaRawEvent {
  id          String    @id @default(cuid())
  /// verbatim Meta payload — shape not ours
  payload     Json
  signatureOk Boolean
  receivedAt  DateTime
  processedAt DateTime?
}

model WaMessage {
  id              String      @id @default(cuid())
  waMessageId     String      @unique
  /// wa_id
  from            String
  customerId      String?
  name            String?
  text            String?
  msgType         String
  ts              DateTime
  direction       WaDirection
  status          WaMsgStatus
  intent          String?
  /// LLM extraction — shape not ours
  entities        Json
  replyText       String?
  answeredByAgent Boolean
  answeredById    String?
  answeredAt      DateTime?

  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  answeredBy Staff?    @relation(fields: [answeredById], references: [id], onDelete: Restrict)

  coveredThreadMemories WaThreadMemory[]
  corrections           AgentCorrection[]
  chatActions           ChatAction[]
  agentRuns             AgentRun[]
  evaluations           AgentEvaluation[]

  // Declared here because they exist in the database. Both were hand-written
  // into 20260820002832 without a matching @@index, so every `migrate dev`
  // since has diffed them as strays and emitted a DROP for them — a silent
  // de-indexing of the inbox one migration after another. The third index on
  // this table, WaMessage_pending_idx, stays hand-written on purpose: it is
  // partial (WHERE direction = 'IN' AND status = 'BARU') and Prisma has no
  // syntax for that, which is also why the differ leaves it alone.
  @@index([from, ts])
  @@index([from, answeredAt])
}

/// Two writers, disjoint column sets (08 §7). The webhook summarizer owns the
/// summary and coveredThrough columns; POS staff own the directive columns and
/// the autoReply switch — whether the bot answers this customer at all.
/// Neither may write the other's columns — that is what makes "the agent can
/// never overwrite a staff directive" structural rather than conventional.
/// (Never write a comment terminator inside a /// doc comment here: Prisma
/// copies it verbatim into the generated .d.ts and breaks the file.)
model WaThreadMemory {
  id               String    @id @default(cuid())
  /// wa_id
  from             String    @unique
  customerId       String?
  /// agent-owned
  summary          String?
  summaryAt        DateTime?
  summaryTurns     Int
  coveredThroughAt DateTime?
  coveredThroughId String?
  /// staff-owned
  directive        String?
  directiveAt      DateTime?
  directiveById    String?
  /// staff-owned. False hands this one thread to a person: the worker's draft
  /// pass skips it entirely and answers every other thread as before. Defaults
  /// true, so a number nobody has ruled on is answered by the bot — the
  /// behaviour every thread had before this column existed.
  /// ⚠️ `dbgenerated`, not `@default(true)`: with a plain default Prisma
  /// sends `true` in every INSERT, and the agent role holds no INSERT on this
  /// staff-owned column — so every memory row the worker tried to create was
  /// refused (found 2026-10-15, apps/worker/test/agentRole.test.ts). The
  /// database's own DEFAULT true is unchanged; Prisma now leaves it to it.
  autoReply        Boolean   @default(dbgenerated("true"))
  autoReplyAt      DateTime?
  autoReplyById    String?
  /// agent-owned. The worker's claim on this thread: only the holder may
  /// answer it until the lease runs out, so N threads run in parallel and one
  /// thread never runs twice (chatbot v2, 2026-10-14).
  leaseUntil       DateTime?
  leasedBy         String?
  /// agent-owned. The router's last lead score (0–100), and when it last
  /// crossed the threshold — the bot's half of the 🔥 tag.
  leadScore        Int?
  leadAt           DateTime?
  /// staff-owned. The staff half of the 🔥 tag, and the clear that ends both
  /// halves — written by a person, or by the sale (owner: a lead clears at
  /// sale). A lead is shown while max(leadAt, leadStaffAt) > leadClearedAt.
  leadStaffAt      DateTime?
  leadStaffById    String?
  leadClearedAt    DateTime?
  /// staff-owned. The inbox read marker: inbound messages after it are unread.
  readAt           DateTime?
  clarifyCount     Int
  clarifyAt        DateTime?
  updatedAt        DateTime

  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  coveredThrough WaMessage? @relation(fields: [coveredThroughId], references: [id], onDelete: Restrict)
  directiveBy    Staff?     @relation("WaThreadMemoryDirectedBy", fields: [directiveById], references: [id], onDelete: Restrict)
  autoReplyBy    Staff?     @relation("WaThreadMemoryAutoReplyBy", fields: [autoReplyById], references: [id], onDelete: Restrict)
  leadStaffBy    Staff?     @relation("WaThreadMemoryLeadStaffBy", fields: [leadStaffById], references: [id], onDelete: Restrict)
}

/// Something a person has to do for a chat customer (owner ask 2026-09-29):
/// the bot handed a conversation over, and this is the task it left behind —
/// a negotiation to answer, a price nobody has set, a booking it may not
/// make. One OPEN row per (from, kind): a second hand-over of the same kind
/// updates the row rather than stacking a new one, which is how a customer
/// raising their offer before anybody answers moves `askPrice` in place.
model ChatAction {
  id           String           @id @default(cuid())
  /// wa_id — the thread, as WaMessage and WaThreadMemory name it.
  from         String
  customerId   String?
  kind         ChatActionKind
  status       ChatActionStatus @default(OPEN)
  /// policy.ts HANDOFF_TOPICS — the finer reason inside the kind.
  topic        String
  /// The bot's note for the colleague, so nobody re-reads the conversation.
  summary      String
  /// The customer's own words that raised or last updated it.
  customerText String?
  unitId       String?
  skuId        String?
  /// What the POS asked when the action was raised (Unit.price, else Sku.price).
  listPrice    BigInt?
  /// NEGOTIATION: the customer's offer, read from their message by code.
  askPrice     BigInt?
  /// What the staff member answered with.
  staffPrice   BigInt?
  /// The newest inbound message this row has read.
  messageId    String?
  createdAt    DateTime
  updatedAt    DateTime
  resolvedAt   DateTime?
  resolvedById String?

  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  unit       Unit?      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  sku        Sku?       @relation(fields: [skuId], references: [id], onDelete: Restrict)
  message    WaMessage? @relation(fields: [messageId], references: [id], onDelete: Restrict)
  resolvedBy Staff?     @relation("ChatActionResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([from, status])
  @@index([status, updatedAt])
}

/// What the bot has learned about the person on the other end of a chat
/// (owner ask 2026-09-29: "the goal is always to get to know the user first").
/// Keyed by wa_id, because most people who write in have never bought
/// anything and have no Customer row; `customerId` links one once there is.
/// Every field is what the customer SAID — none of it is verified.
model CustomerProfile {
  id            String   @id @default(cuid())
  /// wa_id
  from          String   @unique
  customerId    String?
  name          String?
  /// What they want it for: kuliah, editing video, kantor…
  useCase       String?
  /// Whole rupiah, as the customer stated it. ⚠️ Superseded by budgetMin /
  /// budgetMax (2026-10-14) and kept one release so the release before reads
  /// it during a deploy. Drop it after.
  budget        BigInt?
  /// The budget as a range, whole rupiah (owner: budget is a min–max range).
  /// "sekitar 15 jt" is min = max = 15.000.000; "di bawah 20" is max only.
  budgetMin     BigInt?
  budgetMax     BigInt?
  /// The bot's GUESS at an age band ("20–25"). Always shown as an estimate.
  ageEstimate   String?
  /// Job or school, as told or guessed ("mahasiswa DKV", "programmer").
  occupation    String?
  /// What they use now.
  currentDevice String?
  /// Anything else they asked for: colour, size, "yang ringan".
  preference    String?
  updatedAt     DateTime

  customer Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  facts    CustomerProfileFact[]
}

/// One bullet of a customer profile: a usage area, an app, a preference or
/// anything else worth knowing (chatbot v2, 2026-10-14). A table rather than a
/// comma list so "who uses Photoshop" is a query, and rather than JSON because
/// JSON columns are forbidden here. Never deleted: a fact taken back carries
/// `removedAt`.
model CustomerProfileFact {
  id          String          @id @default(cuid())
  profileId   String
  kind        ProfileFactKind
  value       String
  source      FactSource
  createdById String?
  createdAt   DateTime
  removedAt   DateTime?

  profile   CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  createdBy Staff?          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([profileId])
  @@index([kind, value])
}

/// A booking the bot has PROPOSED and the customer has not yet confirmed
/// (chatbot v2). Holds no unit and writes no UnitEvent; confirming it creates
/// the real Reservation in one transaction and sets `reservationId`. The
/// confirm is refused past `expiresAt` or once confirmed.
model ReservationProposal {
  id            String    @id @default(cuid())
  /// wa_id — the only phone the booking can be made for.
  from          String
  custName      String
  /// The visit: when the customer will come to see the units.
  scheduledFor  DateTime
  createdAt     DateTime
  expiresAt     DateTime
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  reservationId String?   @unique

  reservation Reservation?              @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  items       ReservationProposalItem[]

  @@index([from, createdAt])
}

model ReservationProposalItem {
  id         String @id @default(cuid())
  proposalId String
  unitId     String
  sortOrder  Int    @default(0)

  proposal ReservationProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  unit     Unit                @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([proposalId, unitId])
}

/// One bot turn: what the router read, which agents ran, what it cost and how
/// long it took (chatbot v2). Evaluation and the simulator read it.
model AgentRun {
  id            String   @id @default(cuid())
  /// wa_id. A simulator turn has its own tester id.
  from          String
  /// The inbound row whose replyText holds this turn's answer.
  messageId     String?
  dryRun        Boolean  @default(false)
  pipeline      String
  language      String?
  tone          String?
  intent        String?
  leadScore     Int?
  escalateTopic String?
  /// REPLIED, HANDOFF, SKIPPED or ERROR.
  outcome       String
  inputTokens   Int      @default(0)
  cachedTokens  Int      @default(0)
  outputTokens  Int      @default(0)
  /// US dollars × 1 000 000. Not rupiah: what Anthropic bills.
  costMicros    BigInt   @default(0)
  latencyMs     Int      @default(0)
  createdAt     DateTime

  message     WaMessage?        @relation(fields: [messageId], references: [id], onDelete: Restrict)
  steps       AgentRunStep[]
  evaluations AgentEvaluation[]

  @@index([from, createdAt])
  @@index([messageId])
}

model AgentRunStep {
  id           String    @id @default(cuid())
  runId        String
  sortOrder    Int
  agent        AgentRole
  model        String
  /// The tool called, or null for the model call itself.
  tool         String?
  ok           Boolean
  ms           Int
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId])
}

/// A staff verdict on one bot reply (owner, 2026-10-14). A BAD one reaches the
/// bot only when somebody presses Apply, which writes `correctionId`.
model AgentEvaluation {
  id           String      @id @default(cuid())
  messageId    String
  runId        String?
  rating       EvalRating
  reason       EvalReason?
  /// Which agent the reviewer blames, when they can tell.
  agent        AgentRole?
  note         String?
  corrected    String?
  status       EvalStatus  @default(OPEN)
  correctionId String?     @unique
  createdById  String
  createdAt    DateTime
  reviewedById String?
  reviewedAt   DateTime?

  message    WaMessage        @relation(fields: [messageId], references: [id], onDelete: Restrict)
  run        AgentRun?        @relation(fields: [runId], references: [id], onDelete: Restrict)
  correction AgentCorrection? @relation(fields: [correctionId], references: [id], onDelete: Restrict)
  createdBy  Staff            @relation("AgentEvaluationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy Staff?           @relation("AgentEvaluationReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([messageId])
}

model AgentCache {
  id        String   @id @default(cuid())
  /// sha256(kind + q)
  key       String   @unique
  kind      String
  /// decision only — shape not ours
  value     Json
  createdAt DateTime
  expiresAt DateTime
  hits      Int
}

/// Staff-curated Q&A the agent may ground its replies in (owner decision
/// 2026-08-15). Real columns, not JSON: each entry is one question with its
/// approved answer. Deactivate instead of delete so past replies stay
/// explainable.
model AgentKnowledge {
  id          String   @id @default(cuid())
  question    String
  answer      String
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime
  updatedAt   DateTime

  createdBy Staff @relation(fields: [createdById], references: [id], onDelete: Restrict)
}

/// The agent's voice. Exactly one row is active, enforced by a partial unique
/// index rather than by convention — see the migration.
model Persona {
  id          String     @id @default(cuid())
  name        String     @unique
  blurb       String?
  /// The prompt text itself. Free text a staff member wrote.
  prompt      String
  active      Boolean
  /// A built-in cannot be deleted by staff, only deactivated.
  builtIn     Boolean
  /// Which of the three chatbot agents this persona is (chatbot v2). One
  /// persona per agent (owner, 2026-10-14); null for a persona no agent uses.
  agent       AgentRole? @unique
  createdById String?
  createdAt   DateTime
  updatedAt   DateTime

  createdBy Staff? @relation(fields: [createdById], references: [id], onDelete: Restrict)
}

/// A staff rewrite of something the agent sent, replayed to it as house style.
/// This is the learning loop: nothing is fine-tuned, the model simply reads its
/// own past mistakes before it writes the next line.
model AgentCorrection {
  id          String   @id @default(cuid())
  /// The reply that was rewritten, when it came from a real thread.
  messageId   String?
  original    String
  corrected   String
  note        String?
  createdById String
  createdAt   DateTime

  message    WaMessage?       @relation(fields: [messageId], references: [id], onDelete: Restrict)
  createdBy  Staff            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  /// The evaluation whose Apply wrote this correction, if any.
  evaluation AgentEvaluation?
}

