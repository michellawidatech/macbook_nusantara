# Auth0 — hosted login for the API (apps/api).
#
# The API is the confidential OIDC client, not the SPA: it holds the secret and
# does the code exchange server-side. The browser, though, only ever sees the
# SPA's origin — /auth/* is proxied through to the API.
#
# Put the real values in the gitignored secrets file rather than here:
#
#   secrets/webhook-credentials.env      (chmod 600, never committed)
#
# The API reads only its own allow-listed keys out of that file — see
# apps/api/src/secretsFile.ts. A shell variable overrides the file for one run.

# Tenant domain, no scheme.
AUTH0_DOMAIN=dev-d1v40b5ivsgkbd0e.us.auth0.com

# Public identifier — appears in the browser redirect, not a secret.
AUTH0_CLIENT_ID=klwiMKAeZKRzN9ck2M1Ca61lYe0KeXyv

# Secret. Copy from Auth0 → Applications → Settings. Never commit it.
AUTH0_CLIENT_SECRET=

# Encrypts the session cookie. Generate your own:  openssl rand -hex 32
AUTH0_SECRET=

# The origin the BROWSER uses — the SPA's, not the API's port. Vite proxies
# /auth/* through to this API (apps/web/vite.config.ts) and nginx does the same
# in production, so the whole flow stays same-origin.
#
# Register this value + /auth/callback as the Allowed Callback URL in Auth0,
# and this value itself as the Allowed Logout URL. Must be https in production.
AUTH0_BASE_URL=http://localhost:3000
