# apps/api — the knobs `src/config.ts` reads. Every one has a safe default;
# set one only to change it. Sign-in is the app's own since 2026-09-18 (Auth0
# is gone): nothing here is a secret.
#
# The Anthropic credential for the chat agent goes in the gitignored secrets
# file, never here:
#
#   secrets/webhook-credentials.env      (chmod 600, never committed)
#
# The API reads only its own allow-listed keys out of that file — see
# src/secretsFile.ts. A shell variable overrides the file for one run.

# The SPA's origin. Locked for CORS; Vite proxies /api to this API in
# development, so the browser only ever talks to :3000.
# CORS_ORIGIN=http://localhost:3000

# Local HTTP only. Anything else keeps the session cookie Secure.
# SESSION_COOKIE_INSECURE=1

# Sessions end absolutely, not on idle. Default 12 hours.
# SESSION_TTL_MS=43200000

# Sign-in throttle: this many failures per username or per address inside the
# window start a delay that doubles each time, up to the maximum.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MS=900000
# LOGIN_BASE_DELAY_MS=1000
# LOGIN_MAX_DELAY_MS=300000

# Which hops in front of the API are proxies (Express `trust proxy`). The
# default, loopback, is right when everything in front of it — tailscale
# serve, Caddy, Vite — runs on the same machine.
# TRUST_PROXY=loopback
