{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "vitest.config.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "DATABASE_URL",
        "TEST_PGHOST",
        "TEST_PGPORT",
        "TEST_PGDATABASE"
      ]
    },
    "typecheck": {}
  }
}
